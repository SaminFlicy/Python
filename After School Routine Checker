import tkinter as tk
from tkinter import messagebox

# Create the main window
root = tk.Tk()
root.title("After-School Routine Checker")
root.geometry("600x500")
root.resizable(False, False)

# Routine tasks
routine = [
    "Do homework",
    "Take a short break",
    "Practice coding",
    "Read a book",
    "Prepare for tomorrow"
]

current_task = 0


# --------------------------------
# Function: typing event
# --------------------------------
def show_last_character(event):
    text = task_entry.get()

    if text:
        last_character_label.config(
            text="Last character typed: " + text[-1]
        )
    else:
        last_character_label.config(
            text="Last character typed: None"
        )


# --------------------------------
# Function: mouse click event
# --------------------------------
def routine_clicked(event):
    click_label.config(
        text="You clicked the routine area!"
    )


# --------------------------------
# Function: check task
# --------------------------------
def check_task():
    task = task_entry.get().strip()

    if task == "":
        messagebox.showwarning(
            "No Task Entered",
            "Please enter a task first!"
        )
    else:
        result_label.config(
            text="Task added: " + task
        )


# --------------------------------
# Function: next task
# --------------------------------
def next_task():
    global current_task

    result_label.config(
        text="Next task: " + routine[current_task]
    )

    current_task = (current_task + 1) % len(routine)


# --------------------------------
# Title
# --------------------------------
title_label = tk.Label(
    root,
    text="After-School Routine Checker",
    font=("Arial", 20, "bold")
)
title_label.pack(pady=15)


# --------------------------------
# Instructions
# --------------------------------
instruction_label = tk.Label(
    root,
    text="Type a task, click the routine area, or use a button.",
    font=("Arial", 11)
)
instruction_label.pack(pady=5)


# --------------------------------
# Task Entry
# --------------------------------
task_label = tk.Label(
    root,
    text="Enter your task:"
)
task_label.pack(pady=5)

task_entry = tk.Entry(
    root,
    width=40,
    font=("Arial", 12)
)
task_entry.pack(pady=5)

# Bind keyboard event
task_entry.bind("<KeyRelease>", show_last_character)


# --------------------------------
# Last character display
# --------------------------------
last_character_label = tk.Label(
    root,
    text="Last character typed: None",
    font=("Arial", 11)
)
last_character_label.pack(pady=10)


# --------------------------------
# Routine area
# --------------------------------
routine_frame = tk.Frame(
    root,
    width=450,
    height=120,
    borderwidth=3,
    relief="ridge"
)
routine_frame.pack(pady=10)

routine_label = tk.Label(
    routine_frame,
    text="CLICK HERE\n\nAfter-School Routine",
    font=("Arial", 14, "bold")
)
routine_label.place(
    relx=0.5,
    rely=0.5,
    anchor="center"
)

# Bind mouse click event
routine_frame.bind("<Button-1>", routine_clicked)
routine_label.bind("<Button-1>", routine_clicked)


# --------------------------------
# Click message
# --------------------------------
click_label = tk.Label(
    root,
    text="",
    font=("Arial", 10)
)
click_label.pack(pady=5)


# --------------------------------
# Buttons
# --------------------------------
check_button = tk.Button(
    root,
    text="Check Task",
    command=check_task,
    width=15
)
check_button.pack(pady=5)

next_button = tk.Button(
    root,
    text="Next Task",
    command=next_task,
    width=15
)
next_button.pack(pady=5)


# --------------------------------
# Result
# --------------------------------
result_label = tk.Label(
    root,
    text="",
    font=("Arial", 12, "bold")
)
result_label.pack(pady=10)


# Start the application
root.mainloop()
