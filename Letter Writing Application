import tkinter as tk
from tkinter import filedialog, messagebox
import os

# Create the main window
root = tk.Tk()
root.title("Letter Writing Application")
root.geometry("750x550")


# --------------------------------
# Open an existing letter
# --------------------------------
def open_letter():
    file_path = filedialog.askopenfilename(
        title="Open Letter",
        filetypes=[
            ("Text Files", "*.txt"),
            ("All Files", "*.*")
        ]
    )

    if file_path:
        try:
            with open(file_path, "r", encoding="utf-8") as file:
                content = file.read()

            # Clear the text editor
            text_editor.delete("1.0", tk.END)

            # Insert the file contents
            text_editor.insert("1.0", content)

            # Change window title
            root.title("Letter Writing Application - " + file_path)

        except Exception as e:
            messagebox.showerror(
                "Error",
                "Could not open the file."
            )


# --------------------------------
# Save letter as a new file
# --------------------------------
def save_letter():
    file_path = filedialog.asksaveasfilename(
        title="Save Letter As",
        defaultextension=".txt",
        filetypes=[
            ("Text Files", "*.txt"),
            ("All Files", "*.*")
        ]
    )

    if file_path:
        try:
            content = text_editor.get("1.0", tk.END)

            with open(file_path, "w", encoding="utf-8") as file:
                file.write(content)

            # Update window title
            root.title("Letter Writing Application - " + file_path)

            messagebox.showinfo(
                "Saved",
                "Letter saved successfully!"
            )

        except Exception as e:
            messagebox.showerror(
                "Error",
                "Could not save the file."
            )


# --------------------------------
# Clear the editor
# --------------------------------
def clear_letter():
    text_editor.delete("1.0", tk.END)
    root.title("Letter Writing Application")


# --------------------------------
# Heading
# --------------------------------
heading = tk.Label(
    root,
    text="Letter Writing Application",
    font=("Arial", 20, "bold")
)

heading.grid(
    row=0,
    column=0,
    columnspan=3,
    pady=15
)


# --------------------------------
# Instructions
# --------------------------------
instructions = tk.Label(
    root,
    text="Open a letter, edit it, and save it as a new file.",
    font=("Arial", 11)
)

instructions.grid(
    row=1,
    column=0,
    columnspan=3,
    pady=5
)


# --------------------------------
# Buttons
# --------------------------------
open_button = tk.Button(
    root,
    text="Open Letter",
    command=open_letter,
    width=15
)

open_button.grid(
    row=2,
    column=0,
    padx=10,
    pady=10
)


save_button = tk.Button(
    root,
    text="Save As",
    command=save_letter,
    width=15
)

save_button.grid(
    row=2,
    column=1,
    padx=10,
    pady=10
)


clear_button = tk.Button(
    root,
    text="Clear",
    command=clear_letter,
    width=15
)

clear_button.grid(
    row=2,
    column=2,
    padx=10,
    pady=10
)


# --------------------------------
# Text Editor
# --------------------------------
text_editor = tk.Text(
    root,
    width=80,
    height=22,
    font=("Arial", 12),
    wrap="word"
)

text_editor.grid(
    row=3,
    column=0,
    columnspan=3,
    padx=20,
    pady=10
)


# --------------------------------
# Configure grid
# --------------------------------
root.grid_columnconfigure(0, weight=1)
root.grid_columnconfigure(1, weight=1)
root.grid_columnconfigure(2, weight=1)


# Start the application
root.mainloop()
