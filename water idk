from flask import Flask, render_template, request

app = Flask(__name__)

@app.route('/', methods=['GET', 'POST'])
def index():
    result = None

    if request.method == 'POST':
        name = request.form.get('name', '').strip()
        goal = request.form.get('goal', '0')
        glasses = request.form.get('glasses', '0')

        try:
            goal = int(goal)
            glasses = int(glasses)

            if goal <= 0:
                result = {
                    'error': True,
                    'message': 'Daily goal must be greater than 0.'
                }
            else:
                progress = (glasses / goal) * 100
                remaining = max(0, goal - glasses)

                if progress >= 100:
                    status = "🎉 Goal achieved! Great job!"
                elif progress >= 75:
                    status = "Almost there! Keep going!"
                elif progress >= 50:
                    status = "Halfway done. You can do it!"
                else:
                    status = "Just getting started. Drink more water!"

                result = {
                    'error': False,
                    'name': name,
                    'goal': goal,
                    'glasses': glasses,
                    'progress': round(progress, 1),
                    'remaining': remaining,
                    'status': status
                }
        except ValueError:
            result = {
                'error': True,
                'message': 'Please enter valid numbers for goal and glasses.'
            }

    return render_template('index.html', result=result)

if __name__ == '__main__':
    app.run(debug=True)
