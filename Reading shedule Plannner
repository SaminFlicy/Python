import tkinter as tk
from tkinter import messagebox

# Main window
root = tk.Tk()
root.title("Reading Schedule Planner")
root.geometry("500x300")


# Function to open the planner window
def open_planner():
    planner = tk.Toplevel(root)
    planner.title("Reading Planner")
    planner.geometry("450x350")

    # Title
    title = tk.Label(
        planner,
        text="Reading Schedule Planner",
        font=("Arial", 18, "bold")
    )
    title.pack(pady=15)

    # Total pages
    total_label = tk.Label(
        planner,
        text="Enter total number of pages:"
    )
    total_label.pack(pady=5)

    total_entry = tk.Entry(
        planner,
        width=30
    )
    total_entry.pack(pady=5)

    # Pages per day
    daily_label = tk.Label(
        planner,
        text="Pages you plan to read each day:"
    )
    daily_label.pack(pady=5)

    daily_entry = tk.Entry(
        planner,
        width=30
    )
    daily_entry.pack(pady=5)

    # Result label
    result_label = tk.Label(
        planner,
        text="",
        font=("Arial", 12, "bold")
    )
    result_label.pack(pady=15)

    # Calculate function
    def calculate():
        try:
            total_pages = int(total_entry.get())
            pages_per_day = int(daily_entry.get())

            if total_pages <= 0 or pages_per_day <= 0:
                raise ValueError

            # Floor division = complete reading days
            complete_days = total_pages // pages_per_day

            # Modulo = remaining pages
            remaining_pages = total_pages % pages_per_day

            result_label.config(
                text=(
                    "Complete reading days: "
                    + str(complete_days)
                    + "\nRemaining pages: "
                    + str(remaining_pages)
                )
            )

        except ValueError:
            messagebox.showerror(
                "Invalid Input",
                "Please enter positive whole numbers."
            )

    # Calculate button
    calculate_button = tk.Button(
        planner,
        text="Calculate Schedule",
        command=calculate,
        width=20
    )
    calculate_button.pack(pady=10)


# Main window message
main_label = tk.Label(
    root,
    text="Welcome to the Reading Schedule Planner!",
    font=("Arial", 16, "bold")
)
main_label.pack(pady=50)


# Open planner button
open_button = tk.Button(
    root,
    text="Open Reading Planner",
    command=open_planner,
    width=25,
    height=2
)
open_button.pack()


# Start program
root.mainloop()
