import tkinter as tk

# Create the main window
root = tk.Tk()
root.title("Workshop Participant Greeting")
root.geometry("500x400")

# Title
title_label = tk.Label(
    root,
    text="Workshop Participant Greeting",
    font=("Arial", 18, "bold")
)
title_label.pack(pady=15)

# Instructions
instruction_label = tk.Label(
    root,
    text="Enter your name below and click Check In.",
    font=("Arial", 12)
)
instruction_label.pack(pady=5)

# Name label
name_label = tk.Label(
    root,
    text="Participant Name:"
)
name_label.pack(pady=5)

# Entry box
name_entry = tk.Entry(
    root,
    width=35,
    font=("Arial", 12)
)
name_entry.pack(pady=5)


# Function for the Check In button
def check_in():
    name = name_entry.get()

    if name.strip() == "":
        message = "Please enter your name!"
    else:
        message = (
            "Welcome to the workshop, " + name + "!\n\n"
            "We are happy to have you here.\n"
            "Have a great learning experience!\n\n"
            "Workshop Date: November 7, 2025"
        )

    # Clear previous message
    output_text.delete("1.0", tk.END)

    # Display new message
    output_text.insert(tk.END, message)


# Check In button
check_button = tk.Button(
    root,
    text="Check In",
    command=check_in,
    font=("Arial", 12, "bold")
)
check_button.pack(pady=15)

# Text widget for the welcome message
output_text = tk.Text(
    root,
    width=45,
    height=8,
    font=("Arial", 11)
)
output_text.pack(pady=10)

# Start the application
root.mainloop()
